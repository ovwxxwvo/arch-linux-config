" General Settings
set update.lastchecktime 1781537081612
set configversion 2.0

" For syntax highlighting see https://github.com/tridactyl/vim-tridactyl
" vim: set filetype=tridactyl

set hintchars qwerasdfzxcv

set smoothscroll   true
set scrollrepeat   2
set scrollduration 16
command scrollUp   js window.scrollBy({top:-120,behavior:"smooth"})
command scrollDown js window.scrollBy({top: 120,behavior:"smooth"})

unbind <ESC>
unbind q
unbind f
unbind F

bind k  scrollUp
bind l  scrollDown
bind i  scrollpage -0.4
bind o  scrollpage  0.4
bind gg scrollline -1000
bind G  scrollline  1000

bind ,  tabprev
bind .  tabnext

bind c  source
bind x  tabclose
bind z  hint
bind Z  hint -b
bind s  focusinput
bind a  focusinput

bind /  fillcmdline find
bind ?  fillcmdline find
bind h  findnext
bind n  findnext --reverse

bind t  fillcmdline buffer
bind b  fillcmdline bmarks
bind B  tabopen bmarks

bind w  tabopen file:///home/oo/.config/firefox/00/home.html
bind e  tabopen about:preferences

