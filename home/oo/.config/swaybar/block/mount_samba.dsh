#!/usr/bin/env dash

block="$HOME/.config/swaybar/block"
. "$block"/icon.sh
. "$block"/color.sh
LABEL="$ICON_SAMBA"

LIST="
  MR-00   | oo | 1234567890 | 3.0
  HONOR-0 | oo | 1234567890 | 1.0
  HW-00   | oo | 1234567890 | 1.0
  VBOX-00 | oo | 1234567890 | 3.0
  "
HOSTS=$(echo "$LIST" |grep '|' |awk -F"[\t |]+" '{print $2}')
# echo $HOSTS

IPS=""
for h in $HOSTS; do
  ip=$(nmblookup -S "$h" | grep -Eo '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')
  # echo $ip
  if [ -n "$ip" ]; then IPS="$IPS $ip"; fi
  done
HOSTS=""
for ip in $IPS; do
  host=$(nmblookup -A "$ip" |grep -EA1 "status" |grep -v "status" |awk '{print $1}')
  # echo $host
  if [ -n "$host" ]; then HOSTS="$HOSTS $host"; fi
  done
# echo ---------- ----------
  # echo "IPS   $IPS  "
  # echo "HOSTS $HOSTS"

ENABLE=$(echo $IPS | wc -w)
ACTIVE=$(mount | grep -cE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+.*'"$MNT")
# echo ---------- ----------
# echo $ENABLE $ACTIVE

show_block() {
    if [ "$ACTIVE" -eq 1 ]; then
        echo " $LABEL"
    else
        echo ""
    fi
  }

show_color() {
    if [ "$ACTIVE" -eq 1 ]; then
        echo "$c_lelt"
    fi
  }

show_block
show_color

