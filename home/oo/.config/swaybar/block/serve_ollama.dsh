#!/usr/bin/env dash


block="$HOME/.config/swaybar/block"
. "$block"/icon.sh
. "$block"/color.sh
LABEL="$ICON_OLLAMA"


ACTIVE=$( ps -ef \
  |grep -v 'grep' \
  |grep -oc ' ollama serve$' \
  )
# echo ol $ACTIVE


show_block() {
  if [ $ACTIVE -eq 1 ]; then
    BLOCK=" $LABEL"
  else
    BLOCK=""
  fi
  echo "$BLOCK"
  echo "$BLOCK"
  }

show_color() {
  if [ $ACTIVE -eq 1 ]; then
    echo $c_gywt
  fi
  }


show_block
show_color


