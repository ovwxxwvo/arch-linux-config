#!/usr/bin/env dash


SERVE_NAME='ram'
SERVE_DIRT="/tmp/swaybar-$(id -u)"
SERVE_FILE_TXT="${SERVE_DIRT}/state-${SERVE_NAME}.txt"
SERVE_FILE_TMP="${SERVE_DIRT}/state-${SERVE_NAME}.tmp"
DATA=''
mkdir -p "$SERVE_DIRT"


push_data() {
  # echo push_data

  USAGE=$( \
    cat /proc/meminfo \
    |grep -E "MemTotal|MemAvailable" \
    |grep -Eo "[0-9]+" \
    |paste -sd ' ' \
    |awk -F"[\t ]+" '{print (($1-$2)/$1*100)}' \
    |awk '{printf "%02d", $0}' \
    )
    # |awk '{ printf "%04.1f", $0 }' \

  # echo "$USAGE"
  echo "$USAGE" > "$SERVE_FILE_TMP"
  mv "$SERVE_FILE_TMP" "$SERVE_FILE_TXT"

  }


while true ;do
push_data
sleep 1
done


