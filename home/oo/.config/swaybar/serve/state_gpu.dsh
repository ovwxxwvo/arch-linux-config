#!/usr/bin/env dash


SERVE_NAME='gpu'
SERVE_DIRT="/tmp/swaybar-$(id -u)"
SERVE_FILE_TXT="${SERVE_DIRT}/state-${SERVE_NAME}.txt"
SERVE_FILE_TMP="${SERVE_DIRT}/state-${SERVE_NAME}.tmp"
DATA=''
mkdir -p "$SERVE_DIRT"


push_data() {
  # echo push_data

  USAGE=$( \
    cat /sys/class/drm/card1/device/gpu_busy_percent \
    |awk '{printf "%02d", $0}' \
    )
    # |awk '{ printf "%04.1f", $0 }' \

  # echo "$USAGE"
  echo "$USAGE" > "$SERVE_FILE_TMP"
  mv "$SERVE_FILE_TMP" "$SERVE_FILE_TXT"

  }


while true ;do
push_data
sleep 1
done


