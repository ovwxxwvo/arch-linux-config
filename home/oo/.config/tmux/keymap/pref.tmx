# TMUX config,


# basic
  bind -T prefix   Escape   copy-mode
  bind -T prefix   v        run -b '~/.config/tmux/key/paste-clip.sh'
  bind -T prefix   F1       run -b '~/.config/tmux/key/open-file.sh'

# tab & win
  bind -T prefix   q        run -b "~/.config/tmux/key/exit-cmd.sh"
  bind -T prefix   Space    select-pane -R
  bind -T prefix   "'"      rotate-window
  bind -T prefix   m        new-window
  bind -T prefix   [        split-window -h
  bind -T prefix   ]        split-window -v

# tab focus
  bind -T prefix  \,        selectw -p
  bind -T prefix  \.        selectw -n
# win focus
  bind -T prefix   j        selectp -L
  bind -T prefix   k        selectp -U
  bind -T prefix   l        selectp -D
  bind -T prefix  \;        selectp -R

# tab focus
  bind -T prefix   1        selectw -t 1
  bind -T prefix   2        selectw -t 2
  bind -T prefix   3        selectw -t 3
  bind -T prefix   4        selectw -t 4
  bind -T prefix   5        selectw -t 5
  bind -T prefix   6        selectw -t 6
  bind -T prefix   7        selectw -t 7
  bind -T prefix   8        selectw -t 8
  bind -T prefix   9        selectw -t 9
  bind -T prefix   0        selectw -t 10

# win move  in tab
  bind -T prefix   S-Left   swapp -U
  bind -T prefix   S-Right  swapp -D
  bind -T prefix   S-Up     swapp -U
  bind -T prefix   S-Down   swapp -D
# win resize
  bind -T prefix   Up       resizep -U 2
  bind -T prefix   Down     resizep -D 2
  bind -T prefix   Left     resizep -L 2
  bind -T prefix   Right    resizep -R 2


